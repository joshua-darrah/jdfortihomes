# Public site URL used for canonical links, sitemap, robots.txt and social previews.
# Set this to your real deployed domain before launch.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Fallback tour fee used only if the database fee settings are unavailable.
NEXT_PUBLIC_TOUR_FEE_GHS=50

# Manual payment details. Replace every value with your real business details before launch.
NEXT_PUBLIC_PAYMENT_MOMO_NETWORK=
NEXT_PUBLIC_PAYMENT_MOMO_NAME=
NEXT_PUBLIC_PAYMENT_MOMO_NUMBER=
NEXT_PUBLIC_PAYMENT_BANK_NAME=
NEXT_PUBLIC_PAYMENT_ACCOUNT_NAME=
NEXT_PUBLIC_PAYMENT_ACCOUNT_NUMBER=

# Server-only Supabase service-role key. NEVER expose this in NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=
